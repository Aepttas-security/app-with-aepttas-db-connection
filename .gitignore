# Android build outputs - These are GENERATED files.
# Never commit these. They are rebuilt automatically on each machine.
android/app/build/
android/build/
android/.gradle/
android/app/.cxx/

# Pre-bundled JS assets - ROOT CAUSE of stale screens.
# This folder is auto-generated when you run `react-native bundle`.
# It should NEVER be committed so each device always gets a fresh bundle.
android/app/src/main/assets/index.android.bundle
android/app/src/main/assets/index.android.bundle.map
android/app/src/main/assets/*.bundle
android/app/src/main/assets/*.map

